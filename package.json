{
	"name": "maieutik",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"test:e2e": "playwright test",
		"db:dev": "docker compose -f compose.dev.yaml up -d",
		"db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
		"db:seed": "node scripts/seed.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fast-check": "^4.10.2",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/lexend": "^5.3.0",
		"@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
		"@noble/curves": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"@scure/base": "^2.4.0",
		"@scure/bip39": "^2.4.0",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-table": "3.32.0",
		"@tiptap/extensions": "3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"katex": "^0.19.0",
		"postgres": "^3.4.9",
		"uqr": "^0.1.3"
	},
	"engines": {
		"node": ">=22.18"
	},
	"packageManager": "pnpm@10.32.1"
}
